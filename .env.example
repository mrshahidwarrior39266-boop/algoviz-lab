# Google OAuth (set these in Vercel → Settings → Environment Variables, never commit them)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Local development. On Vercel use the production deployment URL.
NEXTAUTH_URL=http://localhost:3000

# PostHog analytics (optional). Leave empty — analytics stays off until both are set.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
